# Supabase application configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
# Server-only. Never prefix this with NEXT_PUBLIC_ and never commit its value.
SUPABASE_SECRET_KEY="your-server-secret-key"

# AI Provider API Keys. Optional: deterministic evaluation remains available.
GROQ_API_KEY="your-groq-api-key-here"
GEMINI_API_KEY="your-gemini-api-key-here"
# Safe default: no evidence is sent to an external AI provider. Change only after
# completing your provider/DPA review. Even when enabled, only explicitly public,
# non-sensitive evaluations may be sent; all other classifications stay local.
AI_EGRESS_MODE="disabled"
AI_PROVIDER_MAX_CONCURRENCY="4"
# Current stable provider defaults. Override only with a model that supports
# JSON output and has been validated by the provider contract tests.
GROQ_MODEL="openai/gpt-oss-20b"
GEMINI_MODEL="gemini-3.6-flash"
# Per-attempt provider timeout and total AI failover budget.
AI_PROVIDER_TIMEOUT_MS="8000"
AI_REQUEST_TIMEOUT_MS="20000"
# Bounds Supabase HTTP calls and deduplicates frequent readiness probes.
DATABASE_REQUEST_TIMEOUT_MS="5000"
HEALTH_CACHE_TTL_MS="5000"

# Sentry observability. The DSN is an ingest identifier, not an application
# secret; keep the auth token used for source-map uploads out of this file.
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
SENTRY_RELEASE=""
SENTRY_TRACES_SAMPLE_RATE="0.05"
# Build-only values enable private source-map upload for readable production
# stack traces. Never expose SENTRY_AUTH_TOKEN through NEXT_PUBLIC_.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
# Sentry's API domain for build uploads. Use https://de.sentry.io for a
# German/EU-region project; it is separate from the browser ingest DSN.
SENTRY_URL=""
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_ENVIRONMENT="development"
NEXT_PUBLIC_SENTRY_RELEASE=""
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.05"

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Deliberately separate, disposable Supabase project for integration tests.
# This suite creates and deletes test users and governed records. It refuses to
# run against NEXT_PUBLIC_SUPABASE_URL.
RUN_SUPABASE_INTEGRATION="false"
SUPABASE_INTEGRATION_URL=""
SUPABASE_INTEGRATION_PUBLISHABLE_KEY=""
SUPABASE_INTEGRATION_SERVICE_ROLE_KEY=""
SUPABASE_INTEGRATION_CONFIRMATION=""

# Deliberately separate, disposable Supabase project for browser E2E tests.
# Run scripts/run-browser-e2e.ps1; it prompts for the service-role key without
# placing it in this file. The runner starts the local app against this project.
RUN_MODELOPS_BROWSER_E2E="false"
MODELOPS_BROWSER_E2E_BASE_URL="http://127.0.0.1:3100"
